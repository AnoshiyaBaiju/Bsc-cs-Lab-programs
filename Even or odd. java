<body>
<h1> check if a number is even or odd </h1>
<label for="number">Enter a number:</label>
<input type="number"id="number">
<button id="checkButton">check</button>
<p id="result"></p>
<script>
document. getElementById("CheckButton"). onclick=function(){
var num=Number(document. getElementById("number").value);
if(num%2==0){                                                                              #output of this program 
document. getElementById("result"). innerText=num+"is Even";                                #Enter a number :| 2|  |check|
}                                                                                            #2 is odd
else{                                                                                         #Enter a number :|11| |check|
document. getElementById("result"). innerText=num+"is Odd";                                   #11 is odd
}
}
</script>
